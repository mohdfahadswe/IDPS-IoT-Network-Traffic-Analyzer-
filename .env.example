# ============================================================================
# NetPulse IoT Security Platform - Environment Configuration
# ============================================================================

PROJECT_NAME=NetPulse IoT Security Platform
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite fallback, PostgreSQL compatible)
# SQLite: sqlite:///./netpulse.db
# PostgreSQL: postgresql://user:password@localhost:5432/netpulse
DATABASE_URL=sqlite:///./netpulse.db

# Authentication
JWT_SECRET=netpulse-super-secret-security-token-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Administrator Account (Automatically Seeded on First Boot)
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=Admin@123
DEMO_USER_NAME=Security Administrator

# Automated Response & Mitigation Policies
AUTO_RESPONSE_ENABLED=true
HIGH_RISK_THRESHOLD=61
CRITICAL_RISK_THRESHOLD=81
DEFAULT_TEMP_BLOCK_MINUTES=15
